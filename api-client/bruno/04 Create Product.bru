meta {
  name: 04 Create Product Bundle
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api-gateway
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{staffToken}}
}

body:json {
  {
    "query": "mutation CreateProductBundle($input: CreateProductBundleDto!) { createProductBundle(input: $input) { _id categoryId name slug description brand isActive variants { _id sku prices { _id currency amount compareAtAmount } } images { _id url sortOrder } } }",
    "variables": {
      "input": {
        "categoryId": "{{categoryId}}",
        "name": "ແລັບທັອບທົດສອບ MillionX",
        "slug": "millionx-demo-laptop-{{runId}}",
        "description": "ສິນຄ້າຕົວຢ່າງສຳລັບທົດສອບ API Phase 1",
        "brand": "MillionX",
        "variants": [
          {
            "sku": "MX-BUNDLE-{{runId}}",
            "name": "RAM 16GB / SSD 512GB",
            "attributesJson": "{\"ram\":\"16GB\",\"storage\":\"512GB\"}",
            "prices": [
              {
                "currency": "LAK",
                "amount": 11500000,
                "compareAtAmount": 12000000
              }
            ]
          }
        ],
        "images": [
          {
            "url": "https://example.com/images/millionx-demo-laptop.jpg",
            "altText": "ແລັບທັອບທົດສອບ MillionX",
            "sortOrder": 0
          }
        ]
      }
    }
  }
}

script:post-response {
  const body = res.getBody();
  if (body?.data?.createProductBundle?._id) {
    bru.setEnvVar("productId", body.data.createProductBundle._id);
    const variantId = body.data.createProductBundle.variants?.[0]?._id;
    if (variantId) bru.setEnvVar("variantId", variantId);
    const priceId = body.data.createProductBundle.variants?.[0]?.prices?.[0]?._id;
    if (priceId) bru.setEnvVar("priceId", priceId);
  }
}

tests {
  test("ສ້າງ Product bundle ໃນ transaction ດຽວ", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().errors).to.equal(undefined);
    expect(res.getBody().data.createProductBundle._id).to.be.a("string");
    expect(res.getBody().data.createProductBundle.variants).to.have.lengthOf(1);
    expect(res.getBody().data.createProductBundle.variants[0].prices).to.have.lengthOf(1);
  });
}
