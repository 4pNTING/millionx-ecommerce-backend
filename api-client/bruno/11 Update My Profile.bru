meta {
  name: 11 Update My Profile
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api-gateway
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{customerToken}}
}

body:json {
  {
    "query": "mutation UpdateCustomerProfile($input: UpdateCustomerProfileInput!) { updateCustomerProfile(input: $input) { id firstName lastName email phone isActive } }",
    "variables": {
      "input": {
        "firstName": "ສົມພອນ",
        "lastName": "ໄຊຍະວົງ",
        "email": "{{customerIdentifier}}",
        "phone": "+85620{{runId}}"
      }
    }
  }
}

tests {
  test("ອັບເດດໂປຣໄຟລ໌ Customer ສຳເລັດ", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().errors).to.equal(undefined);
    expect(res.getBody().data.updateCustomerProfile.firstName).to.equal("ສົມພອນ");
  });
}
