meta {
  name: 08 List Products
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api-gateway
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "query": "query Products($input: LoadProductDto) { products(input: $input) { total page limit items { _id categoryId name slug description brand isActive variants { _id sku name attributesJson prices { _id currency amount compareAtAmount } } images { _id url altText sortOrder } } } }",
    "variables": {
      "input": {
        "includeDescendants": false,
        "currency": "LAK",
        "page": 1,
        "limit": 20
      }
    }
  }
}

tests {
  test("ສາມາດດຶງລາຍການສິນຄ້າໄດ້", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().errors).to.equal(undefined);
    expect(res.getBody().data.products.items).to.be.an("array");
  });
}
