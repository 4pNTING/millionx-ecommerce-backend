meta {
  name: 06 Set Price
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api-gateway
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{staffToken}}
}

body:json {
  {
    "query": "mutation SetProductPrice($input: SetProductPriceDto!) { setProductPrice(input: $input) { _id name variants { _id sku prices { _id currency amount compareAtAmount isActive } } } }",
    "variables": {
      "input": {
        "variantId": "{{variantId}}",
        "currency": "LAK",
        "amount": 12500000,
        "compareAtAmount": 13900000
      }
    }
  }
}

script:post-response {
  const variants = res.getBody()?.data?.setProductPrice?.variants || [];
  const currentVariant = variants.find(v => v._id === bru.getEnvVar("variantId"));
  const price = currentVariant?.prices?.find(p => p.currency === "LAK");
  if (price?._id) {
    bru.setEnvVar("priceId", price._id);
  }
}

tests {
  test("ກຳນົດລາຄາ LAK ໃຫ້ Variant ສຳເລັດ", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().errors).to.equal(undefined);
    expect(res.getBody().data.setProductPrice._id).to.be.a("string");
  });
}
