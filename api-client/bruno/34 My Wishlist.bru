meta {
  name: 34 My Wishlist
  type: http
  seq: 34
}

post {
  url: {{baseUrl}}/api-gateway
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{customerToken}}
}

body:json {
  {
    "query": "query MyWishlist { myWishlist { _id customerId items { _id productId productName productSlug brand imageUrl minPrice currency addedAt } } }"
  }
}

tests {
  test("ສາມາດດຶງລາຍການ Wishlist ຂອງລູກຄ້າໄດ້", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().errors).to.equal(undefined);
    expect(res.getBody().data.myWishlist._id).to.be.a("string");
  });
}

