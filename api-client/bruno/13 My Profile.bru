meta {
  name: 13 My Profile
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api-gateway
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{customerToken}}
}

body:json {
  {
    "query": "query MyProfile { myCustomerProfile { id firstName lastName email phone isActive addresses { id label recipientName phone addressLine1 addressLine2 village district province postalCode countryCode latitude longitude isDefault } } }"
  }
}

tests {
  test("ສາມາດອ່ານໂປຣໄຟລ໌ແລະທີ່ຢູ່ຂອງ Customer", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().errors).to.equal(undefined);
    expect(res.getBody().data.myCustomerProfile.addresses).to.be.an("array");
  });
}
