meta {
  name: 30 Update Cart Item
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/api-gateway
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{customerToken}}
}

body:json {
  {
    "query": "mutation UpdateCartItem($input: UpdateCartItemDto!) { updateCartItem(input: $input) { _id totalItems subtotal items { _id variantId quantity } } }",
    "variables": {
      "input": {
        "_id": "{{cartItemId}}",
        "quantity": 3
      }
    }
  }
}

tests {
  test("ສາມາດແກ້ໄຂຈຳນວນສິນຄ້າໃນກະຕ່າໄດ້", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().errors).to.equal(undefined);
    expect(res.getBody().data.updateCartItem._id).to.be.a("string");
  });
}

