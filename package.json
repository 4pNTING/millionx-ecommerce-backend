{
  "name": "millionx-ecommerce-backend",
  "version": "1.0.0",
  "description": "MillionX E-commerce backend with NestJS, GraphQL, gRPC and PostgreSQL",
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc && npm run copy:proto",
    "copy:proto": "node copy-proto.js",
    "start": "node dist/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "infra:up": "docker compose up -d --wait postgres redis",
    "infra:status": "docker compose ps postgres redis",
    "infra:logs": "docker compose logs -f postgres redis",
    "infra:stop": "docker compose stop postgres redis",
    "dev:local": "npm run infra:up && npm run start:dev",
    "docker:full": "docker compose --profile full up -d --build",
    "dev:start": "npm run start:dev",
    "start:dev2": "ENV_FILE=.env.linux ts-node -r tsconfig-paths/register src/main.ts",
    "dev2": "npm run start:dev2",
    "start:prod": "node dist/main.js",
    "seed": "ts-node -r tsconfig-paths/register src/seed.ts",
    "db:migrate:customer-auth": "ts-node -r tsconfig-paths/register src/migrate-customer-auth.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@apollo/server": "^4.13.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/apollo": "^12.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/graphql": "^12.0.0",
    "@nestjs/microservices": "^10.4.22",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/typeorm": "^10.0.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "graphql": "^16.6.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.17.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "ts-morph": "^27.0.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^4.0.1",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  }
}
